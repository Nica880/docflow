# DocFlow configuration. Copy to `.env` (git-ignored) and adjust.
#
# Every variable maps to a field of core/config.py::Settings (name uppercased); unset = default.
# `.env` serves two purposes:
#   1. Host-side runs (`uv run docflow ...`, `make test-integration`) read it directly, so the
#      connection URLs below point at the ports docker compose publishes on localhost.
#   2. docker compose reads it for ${VAR} interpolation of the user-tunable values only
#      (LLM_*, EMBED_MODEL, SEC_USER_AGENT, LOG_LEVEL, OTEL_*). Inside containers the service
#      URLs (postgres, minio, localstack, Ollama) and data paths are fixed in docker-compose.yml.

# --- SEC EDGAR ----------------------------------------------------------------------------
# Required for live ingestion. SEC fair-access policy: descriptive User-Agent with a real
# contact email. Do NOT use a '+' alias in the email (you+tag@...): sec.gov answers 403.
SEC_USER_AGENT="DocFlow research your.name@example.com"
# Requests/second to sec.gov (SEC limit is 10; the backfill DAG splits this across tasks).
SEC_MAX_RPS=8
# Offline mode: serve EDGAR from recorded fixtures instead of sec.gov (CI / demos). Leave it
# unset for live data - an empty value is NOT the same as unset.
# EDGAR_FIXTURES_DIR=tests/fixtures/edgar

# --- Postgres (app state, review queue, pgvector) -----------------------------------------
DATABASE_URL=postgresql+psycopg://docflow:docflow@localhost:5432/docflow

# --- Object storage: MinIO (S3 API) -------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=docflow
S3_SECRET_KEY=docflow-secret
S3_REGION=us-east-1
BRONZE_BUCKET=docflow-bronze
SILVER_BUCKET=docflow-silver

# --- Queue: LocalStack SQS ----------------------------------------------------------------
SQS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_NAME=docflow-extract
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- LLM: Ollama, running natively on the host (Metal GPU on macOS) -----------------------
# ollama | fake (deterministic, no LLM needed - CI and offline demo)
LLM_PROVIDER=ollama
# Host-side URL. Containers always use http://host.docker.internal:11434 (see compose).
# On Linux, start Ollama with OLLAMA_HOST=0.0.0.0 so containers can reach it.
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_COMPARE_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
# EMBED_DIM=768
# LLM_NUM_CTX=8192
# LLM_TIMEOUT_S=300
# PROMPT_VERSION=v1
# Fields below this confidence go to the human review queue.
# CONFIDENCE_THRESHOLD=0.7

# --- Warehouse (Parquet lake + dbt-duckdb gold) -------------------------------------------
# Gold DB = $WAREHOUSE_DIR/gold.duckdb. In compose these live on the shared `docflow-data`
# volume (/app/data/...) mounted by api, worker and airflow.
WAREHOUSE_DIR=data/warehouse
LAKE_DIR=data/lake
DBT_PROJECT_DIR=warehouse
# Read by warehouse/profiles.yml and the dbt sources; must match LAKE_DIR and
# WAREHOUSE_DIR/gold.duckdb.
DOCFLOW_LAKE_DIR=data/lake
DOCFLOW_GOLD_DB=data/warehouse/gold.duckdb

# --- API / agent --------------------------------------------------------------------------
# API_CORS_ORIGINS=["http://localhost:4200","http://localhost:8080"]
# AGENT_MAX_STEPS=6
# SQL_ROW_LIMIT=200
# SQL_TIMEOUT_S=5

# --- Demo / small mode --------------------------------------------------------------------
# DEMO_YEARS=10
# DEMO_MAX_FILINGS=500
# DEMO_EXTRACT_FILINGS=12
# DEMO_EMBED_LATEST_ONLY=true
# EMBED_MAX_CHUNKS_PER_SECTION=40

# --- Observability ------------------------------------------------------------------------
# OTLP/HTTP endpoint for traces; empty = tracing off. Host-side: http://localhost:4318.
# `make up-all` sets http://otel-collector:4318 for the containers.
OTEL_EXPORTER_OTLP_ENDPOINT=
# SERVICE_NAME=docflow
LOG_LEVEL=INFO
